pkgname=system-editor
pkgver=1.0.0
pkgrel=1
pkgdesc="Simple text editor for system/config files"
arch=('x86_64')
url="https://github.com/toffeehpa/system-editor"
license=('MIT')
depends=('qt6-base' 'qt6-5compat')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::https://github.com/toffeehpa/system-editor/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
